{
  "rewrites": [
    {
      "source": "/privacidad",
      "destination": "/privacidad.html"
    },
    {
      "source": "/terminos",
      "destination": "/terminos.html"
    },
    {
      "source": "/whatsapp-para-desarrolladoras-inmobiliarias",
      "destination": "/whatsapp-para-desarrolladoras-inmobiliarias.html"
    },
    {
      "source": "/precalificar-interesados-inmobiliarios",
      "destination": "/precalificar-interesados-inmobiliarios.html"
    },
    {
      "source": "/proyecto-en-pozo-consultas-whatsapp",
      "destination": "/proyecto-en-pozo-consultas-whatsapp.html"
    },
    {
      "source": "/en",
      "destination": "/en.html"
    },
    {
      "source": "/pt",
      "destination": "/pt.html"
    },
    {
      "source": "/:pageSlug",
      "destination": "/api/page?slug=:pageSlug"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; media-src 'self'; connect-src 'self'; form-action 'self'; base-uri 'none'; frame-ancestors 'none'"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/(index.html|privacidad|privacidad.html|terminos|terminos.html|precalificar-interesados-inmobiliarios|precalificar-interesados-inmobiliarios.html|proyecto-en-pozo-consultas-whatsapp|proyecto-en-pozo-consultas-whatsapp.html|whatsapp-para-desarrolladoras-inmobiliarias|whatsapp-para-desarrolladoras-inmobiliarias.html|en|en.html|pt|pt.html)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; media-src 'self'; connect-src 'self'; form-action 'self'; base-uri 'none'; frame-ancestors 'none'"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/videos/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
